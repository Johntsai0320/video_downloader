# Universal Video Hub Web / Cloud Environment Variables Example

# Server bind configuration
HOST=0.0.0.0
PORT=8000

# Set to 1 in cloud containers (Render / Koyeb) to use temp dir and enable TTL cleanup
CLOUD_ENV=0
AUTO_CLEANUP=0
FILE_TTL_SECONDS=600
MAX_CONCURRENT_DOWNLOADS=4

# Optional custom download folder
# DOWNLOAD_DIR=/tmp/WebVideoDownloads

# Security & authentication (recommended for public cloud deployment)
# ALLOWED_ORIGINS=https://johntsai0320.github.io
# API_ACCESS_TOKEN=replace-with-strong-random-token

# Cookie sources (use either raw COOKIES_DATA or a file path COOKIE_FILE)
# COOKIES_DATA=
# COOKIE_FILE=/path/to/cookies.txt

# Set to 1 only if running behind an SSL-intercepting proxy without trusted system CA
ALLOW_INSECURE_SSL=0
